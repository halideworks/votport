<Page x:Class="Votport.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="12">
    <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}" />
    <TextBlock Text="Receive into" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock x:Name="FolderText" Style="{StaticResource Mono}" VerticalAlignment="Center" MaxWidth="420" />
      <Button Content="Choose" Click="Choose_Click" />
      <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" />
    </StackPanel>
    <ToggleSwitch x:Name="NotifySwitch" Header="Notify when a transfer ends" Toggled="Notify_Toggled" />
    <ToggleSwitch x:Name="TraySwitch" Header="Keep running in the tray when the window is closed" Toggled="Tray_Toggled" />
    <ToggleSwitch x:Name="StartSwitch" Header="Start with Windows, minimized to the tray" Toggled="Start_Toggled" />
    <TextBlock x:Name="CoreText" Foreground="{ThemeResource VotMutedBrush}" />
  </StackPanel>
</Page>
