<Page x:Class="Votport.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Votport">
  <ScrollViewer Padding="0,0,20,0">
    <StackPanel Spacing="16">
      <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}" />

      <!-- Home port -->
      <StackPanel Padding="14" Spacing="8" Background="{ThemeResource VotPanelBrush}" CornerRadius="8">
        <TextBlock Text="HOME PORT" Style="{StaticResource SectionLabel}" Margin="0" />
        <StackPanel x:Name="SignedOut" Spacing="8">
          <TextBlock Text="Sign in to your votport to issue links and deliver from its library." FontSize="12"
              Foreground="{ThemeResource VotMutedBrush}" TextWrapping="Wrap" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BaseBox" PlaceholderText="https://drop.example" />
            <PasswordBox x:Name="AdminPasswordBox" Grid.Column="1" PlaceholderText="Admin password" />
            <Button x:Name="SignInButton" Grid.Column="2" Content="Sign in" Click="SignIn_Click" Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
        <Grid x:Name="SignedIn" ColumnSpacing="8" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock x:Name="PortText" />
            <TextBlock Text="Issue links, deliver from the library, and see what lands." FontSize="12"
                Foreground="{ThemeResource VotMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="Sign out" Click="SignOut_Click" />
        </Grid>
        <TextBlock x:Name="PortProblem" Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Watch folders -->
      <StackPanel Padding="14" Spacing="8" Background="{ThemeResource VotPanelBrush}" CornerRadius="8">
        <TextBlock Text="WATCH FOLDERS" Style="{StaticResource SectionLabel}" Margin="0" />
        <TextBlock Text="Anything placed in a watched folder ships to its request link once it holds still, then moves into a shipped folder inside it."
            FontSize="12" Foreground="{ThemeResource VotMutedBrush}" TextWrapping="Wrap" />
        <ItemsControl x:Name="WatchList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:WatchItem">
              <Grid Padding="10" Margin="0,0,0,6" Background="{ThemeResource VotPanelHoverBrush}" CornerRadius="6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind Dir}" Style="{StaticResource Mono}" />
                  <TextBlock Text="{x:Bind Link}" Style="{StaticResource Mono}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Remove" Click="RemoveWatch_Click" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Choose Folder" Click="ChooseWatch_Click" />
          <TextBlock x:Name="WatchFolderText" Text="No folder chosen" Style="{StaticResource Mono}"
              Foreground="{ThemeResource VotMutedBrush}" VerticalAlignment="Center" MaxWidth="420" />
        </StackPanel>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="WatchLinkBox" PlaceholderText="Request link" />
          <DropDownButton x:Name="ShipToButton" Grid.Column="1" Content="Ship to" Visibility="Collapsed">
            <DropDownButton.Flyout>
              <MenuFlyout x:Name="ShipToMenu" />
            </DropDownButton.Flyout>
          </DropDownButton>
          <PasswordBox x:Name="WatchPasswordBox" Grid.Column="2" PlaceholderText="Password" Width="140" Visibility="Collapsed" />
          <Button x:Name="WatchButton" Grid.Column="3" Content="Watch" Click="AddWatch_Click" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="WatchPreviewText" Visibility="Collapsed" TextWrapping="Wrap" />
        <TextBlock x:Name="WatchProblem" Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Text="Receive into" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="FolderText" Style="{StaticResource Mono}" VerticalAlignment="Center" MaxWidth="420" />
        <Button Content="Choose" Click="Choose_Click" />
        <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" />
      </StackPanel>
      <ToggleSwitch x:Name="NotifySwitch" Header="Notify when a transfer ends" Toggled="Notify_Toggled" />
      <ToggleSwitch x:Name="TraySwitch" Header="Keep running in the tray when the window is closed" Toggled="Tray_Toggled" />
      <ToggleSwitch x:Name="StartSwitch" Header="Start with Windows, minimized to the tray" Toggled="Start_Toggled" />
      <TextBlock x:Name="CoreText" Foreground="{ThemeResource VotMutedBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>
