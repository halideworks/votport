<Page x:Class="Votport.DeliverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Votport">
  <Grid RowSpacing="12" Margin="0,0,20,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- The title row reads as a path back: a chevron and LINKS as a link,
         then the page's own label in the same section type. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <HyperlinkButton x:Name="BackButton" Padding="0" Click="Back_Click" VerticalAlignment="Center" AutomationProperties.Name="Links">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE76B;" FontSize="10" VerticalAlignment="Center" />
          <TextBlock Text="LINKS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="150" VerticalAlignment="Center" />
        </StackPanel>
      </HyperlinkButton>
      <TextBlock Text="/" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
      <TextBlock Text="NEW DELIVERY" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
    </StackPanel>
    <!-- Files from this machine go up to the port first, then get ticked
         below like anything already there. -->
    <Border x:Name="DropZone" Grid.Row="1" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
        Background="{ThemeResource VotPanelBrush}" BorderBrush="{ThemeResource VotBorderBrush}" BorderThickness="1"
        CornerRadius="6" Padding="12,10">
      <StackPanel Spacing="8">
        <TextBlock x:Name="DropText" Text="Drop files or folders here" Foreground="{ThemeResource VotMutedBrush}"
            TextTrimming="CharacterEllipsis" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="ChooseButton" Content="Choose Files" Click="Choose_Click" />
          <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="Choose Folder" Click="ChooseFolder_Click" />
          <Button x:Name="CancelUploadButton" Grid.Column="1" Content="Cancel" Click="CancelUpload_Click" Visibility="Collapsed" />
          <Button x:Name="PasteButton" Grid.Column="2" Content="Paste" Click="Paste_Click" />
          <TextBox x:Name="FolderBox" Grid.Column="4" PlaceholderText="Folder on the port" Width="170"
              ToolTipService.ToolTip="The folder on the port the files go into" />
        </Grid>
      </StackPanel>
    </Border>
    <StackPanel x:Name="Crumbs" Grid.Row="2" Orientation="Horizontal" Spacing="4" />
    <Border Grid.Row="3" Background="{ThemeResource VotPanelBrush}" CornerRadius="8" Padding="8">
      <Grid RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="BrowserNote" Text="Reading what is on the port" Foreground="{ThemeResource VotMutedBrush}" Margin="6" />
        <ListView x:Name="Entries" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entries_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LibraryEntry">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind Chosen, Mode=TwoWay}" Visibility="{x:Bind IsFile}" MinWidth="0" />
                <FontIcon Glyph="&#xE8B7;" Visibility="{x:Bind IsFolder}" Foreground="{ThemeResource VotMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Spacing="8">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LabelBox" PlaceholderText="Label, e.g. Final grade for Alex" />
        <PasswordBox x:Name="DeliveryPasswordBox" Grid.Column="1" PlaceholderText="Password (optional)" />
      </Grid>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <NumberBox x:Name="ExpiresBox" Value="7" PlaceholderText="7" Minimum="1" SpinButtonPlacementMode="Inline" Width="190">
          <NumberBox.Header>
            <TextBlock Text="Expires after (days)" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
          </NumberBox.Header>
        </NumberBox>
        <NumberBox x:Name="DownloadsBox" Grid.Column="1" PlaceholderText="Unlimited" Minimum="1"
            SpinButtonPlacementMode="Inline" Width="190">
          <NumberBox.Header>
            <TextBlock Text="Downloads allowed" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
          </NumberBox.Header>
        </NumberBox>
        <Button x:Name="IssueButton" Grid.Column="2" Click="Issue_Click" Style="{StaticResource AccentButtonStyle}"
            HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
      </Grid>
      <StackPanel x:Name="IssuedPanel" Spacing="4" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="IssuedText" Style="{StaticResource Mono}" Foreground="{ThemeResource VotOkBrush}"
              VerticalAlignment="Center" IsTextSelectionEnabled="True" MaxWidth="520" />
          <Button Content="Copy" Click="CopyIssued_Click" MinWidth="72" />
        </StackPanel>
        <TextBlock Text="This is the only time the link is shown; the recipient pastes it into Receive." FontSize="12"
            Foreground="{ThemeResource VotMutedBrush}" />
      </StackPanel>
      <TextBlock x:Name="ProblemText" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
