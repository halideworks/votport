<Page x:Class="Votport.DeliverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Votport">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="DELIVER" Style="{StaticResource SectionLabel}" />
    <StackPanel x:Name="Crumbs" Grid.Row="1" Orientation="Horizontal" Spacing="4" />
    <Border Grid.Row="2" Background="{ThemeResource VotPanelBrush}" CornerRadius="8" Padding="8">
      <Grid RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="BrowserNote" Text="Reading the library" Foreground="{ThemeResource VotMutedBrush}" Margin="6" />
        <ListView x:Name="Entries" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entries_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:LibraryEntry">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind Chosen, Mode=TwoWay}" Visibility="{x:Bind IsFile}" MinWidth="0" />
                <FontIcon Glyph="&#xE8B7;" Visibility="{x:Bind IsFolder}" Foreground="{ThemeResource VotMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Spacing="8">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="LabelBox" PlaceholderText="Label, e.g. Final grade for Alex" />
        <PasswordBox x:Name="DeliveryPasswordBox" Grid.Column="1" PlaceholderText="Password (optional)" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="ExpiresBox" PlaceholderText="Expires after (days)" Text="7" Width="170" />
        <TextBox x:Name="DownloadsBox" PlaceholderText="Downloads allowed" Width="170" />
        <TextBlock x:Name="ChosenText" Foreground="{ThemeResource VotMutedBrush}" VerticalAlignment="Center" />
        <Button x:Name="IssueButton" Content="Issue delivery" Click="Issue_Click" Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
      <StackPanel x:Name="IssuedPanel" Spacing="4" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="IssuedText" Style="{StaticResource Mono}" Foreground="{ThemeResource VotOkBrush}"
              VerticalAlignment="Center" IsTextSelectionEnabled="True" MaxWidth="520" />
          <Button Content="Copy" Click="CopyIssued_Click" />
        </StackPanel>
        <TextBlock Text="This is the only time the link is shown; the recipient pastes it into Receive." FontSize="12"
            Foreground="{ThemeResource VotMutedBrush}" />
      </StackPanel>
      <TextBlock x:Name="ProblemText" Visibility="Collapsed" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
