<Application x:Class="Votport.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The votport tokens from web/assets/style.css, dark block. -->
      <Color x:Key="VotBg">#FF0B141E</Color>
      <Color x:Key="VotText">#FFF8FAFC</Color>
      <Color x:Key="VotMuted">#FF8896A6</Color>
      <Color x:Key="VotProgress">#FF38BDF8</Color>
      <Color x:Key="VotOk">#FF5FD4A2</Color>
      <Color x:Key="VotDanger">#FFF0928D</Color>
      <SolidColorBrush x:Key="VotBgBrush" Color="{StaticResource VotBg}" />
      <SolidColorBrush x:Key="VotTextBrush" Color="{StaticResource VotText}" />
      <SolidColorBrush x:Key="VotMutedBrush" Color="{StaticResource VotMuted}" />
      <SolidColorBrush x:Key="VotProgressBrush" Color="{StaticResource VotProgress}" />
      <SolidColorBrush x:Key="VotOkBrush" Color="{StaticResource VotOk}" />
      <SolidColorBrush x:Key="VotDangerBrush" Color="{StaticResource VotDanger}" />
      <SolidColorBrush x:Key="VotPanelBrush" Color="#06FFFFFF" />
      <SolidColorBrush x:Key="VotBorderBrush" Color="#14FFFFFF" />
      <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{StaticResource VotMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
