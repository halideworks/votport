<Application x:Class="Votport.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Generated from client/design/tokens.json; both theme blocks. -->
        <ResourceDictionary Source="ms-appx:///Tokens.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The votport type, bundled under the OFL; the system families
           stand in until the file resolves. -->
      <FontFamily x:Key="VotSansFont">ms-appx:///Assets/Fonts/PlusJakartaSans-Variable.ttf#Plus Jakarta Sans, Segoe UI Variable, Segoe UI</FontFamily>
      <FontFamily x:Key="VotMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Variable.ttf#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
      <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="150" />
        <Setter Property="Foreground" Value="{ThemeResource VotMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VotMonoFont}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
