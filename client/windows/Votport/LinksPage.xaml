<Page x:Class="Votport.LinksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Votport">
  <ScrollViewer Padding="0,0,20,0">
    <StackPanel Spacing="16">
      <TextBlock Text="LINKS" Style="{StaticResource SectionLabel}" />

      <TextBlock Text="REQUESTS" Style="{StaticResource SectionLabel}" Margin="0" />
      <!-- Issue a request link -->
      <StackPanel Padding="14" Spacing="8" Background="{ThemeResource VotPanelBrush}" CornerRadius="8">
        <TextBlock Text="Issue a request link" FontWeight="SemiBold" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="LabelBox" PlaceholderText="Label, e.g. Dailies from Alex" />
          <PasswordBox x:Name="RequestPasswordBox" Grid.Column="1" PlaceholderText="Password (optional)" />
        </Grid>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <NumberBox x:Name="ExpiresBox" PlaceholderText="Never" Minimum="1"
              SpinButtonPlacementMode="Inline" Width="190">
            <NumberBox.Header>
              <TextBlock Text="Closes after (days)" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
            </NumberBox.Header>
          </NumberBox>
          <NumberBox x:Name="CapBox" Grid.Column="1" PlaceholderText="Port default"
              SpinButtonPlacementMode="Inline" Width="190">
            <NumberBox.Header>
              <TextBlock Text="Accepts up to (GB)" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
            </NumberBox.Header>
          </NumberBox>
          <Button x:Name="IssueButton" Grid.Column="2" Content="Issue request link" Click="Issue_Click" Style="{StaticResource AccentButtonStyle}"
              HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
        </Grid>
        <StackPanel x:Name="IssuedPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
          <TextBlock x:Name="IssuedText" Style="{StaticResource Mono}" Foreground="{ThemeResource VotOkBrush}"
              VerticalAlignment="Center" IsTextSelectionEnabled="True" MaxWidth="520" />
          <Button Content="Copy" Click="CopyIssued_Click" MinWidth="72" />
        </StackPanel>
        <TextBlock x:Name="ProblemText" Visibility="Collapsed" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock x:Name="NoRequests" Text="No open request links." Foreground="{ThemeResource VotMutedBrush}" />
      <ItemsControl x:Name="RequestList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:RequestItem">
            <Grid Padding="12" Margin="0,0,0,8" Background="{ThemeResource VotPanelBrush}" CornerRadius="8" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Label}" />
                <TextBlock Text="{x:Bind Url}" Style="{StaticResource Mono}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
                <TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Copy" Click="CopyRequest_Click" MinWidth="72" />
              <Button Grid.Column="2" Content="Close" Click="CloseRequest_Click" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="DELIVERIES" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
      <!-- A new delivery: the library browser is its own page. -->
      <Grid Padding="14" ColumnSpacing="12" Background="{ThemeResource VotPanelBrush}" CornerRadius="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="Issue a delivery" FontWeight="SemiBold" />
          <TextBlock Text="Drop files, or pick what is already on the port; the recipient gets one link." FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
        </StackPanel>
        <Button x:Name="NewDeliveryButton" Grid.Column="1" Content="New delivery" Click="NewDelivery_Click"
            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="NoDeliveries" Text="No deliveries issued yet." Foreground="{ThemeResource VotMutedBrush}" />
      <ItemsControl x:Name="DeliveryList">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:DeliveryItem">
            <Grid Padding="12" Margin="0,0,0,8" Background="{ThemeResource VotPanelBrush}" CornerRadius="8" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind Name}" />
                <TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Revoke" Visibility="{x:Bind Live}" Click="Revoke_Click" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
