<Window x:Class="Votport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Votport"
    Title="votport">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid Background="{ThemeResource VotBgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- The app draws its own title bar so it follows the theme and the
         type; the caption buttons stay the system's, coloured to match. -->
    <Grid x:Name="TitleBar" Height="36" Padding="16,0,0,0" VerticalAlignment="Top">
      <TextBlock Text="votport" VerticalAlignment="Center" FontSize="12"
          FontFamily="{StaticResource VotSansFont}" Foreground="{ThemeResource VotMutedBrush}" />
    </Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False" OpenPaneLength="180" SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked"
        Background="{ThemeResource VotBgBrush}" FontFamily="{StaticResource VotSansFont}">
      <NavigationView.PaneHeader>
        <!-- The web masthead's mark: the ship on its square, the name. -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0" VerticalAlignment="Center">
          <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="24" Height="24" />
          <TextBlock Text="votport" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Send" Tag="send" Icon="Send" />
        <NavigationViewItem Content="Receive" Tag="receive" Icon="Download" />
        <!-- Signed in to a port only. -->
        <NavigationViewItem x:Name="ShareItem" Content="Share" Tag="share" Icon="Share" Visibility="Collapsed" />
        <NavigationViewItem x:Name="LinksItem" Content="Manage links" Tag="links" Icon="Link" Visibility="Collapsed" />
        <NavigationViewItem Content="Transfers" Tag="transfers" Icon="List">
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="ActiveBadge" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
      </NavigationView.MenuItems>
      <Frame x:Name="Pages" Padding="20,20,0,20" />
    </NavigationView>
  </Grid>
</Window>
