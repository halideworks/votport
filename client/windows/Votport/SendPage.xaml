<Page x:Class="Votport.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12" Margin="0,0,20,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="SEND" Style="{StaticResource SectionLabel}" Margin="0" />
      <TextBlock Text="Send files to an existing request link." FontSize="12" Foreground="{ThemeResource VotMutedBrush}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="LinkBox" PlaceholderText="Request link" />
      <!-- Signed in to a port: its open request links, one click. -->
      <DropDownButton x:Name="ShipToButton" Grid.Column="1" Content="Your requests" Visibility="Collapsed">
        <DropDownButton.Flyout>
          <MenuFlyout x:Name="ShipToMenu" />
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>
    <TextBlock x:Name="PreviewText" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap"
        Foreground="{ThemeResource VotMutedBrush}" />
    <PasswordBox x:Name="PasswordBox" Grid.Row="3" PlaceholderText="Password" Visibility="Collapsed" />
    <Border x:Name="DropZone" Grid.Row="4" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
        Background="{ThemeResource VotPanelBrush}" BorderBrush="{ThemeResource VotBorderBrush}"
        BorderThickness="1" CornerRadius="6" MinHeight="160">
      <Grid>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="{ThemeResource VotMutedBrush}" />
          <TextBlock Text="Drop files or folders here" Foreground="{ThemeResource VotMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="They ship from where they are; nothing is copied first." FontSize="12"
              Foreground="{ThemeResource VotMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <ListView x:Name="Paths" Visibility="Collapsed" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" Style="{StaticResource Mono}" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
      <Button Content="Choose Files" Click="Choose_Click" />
      <Button Content="Choose Folder" Click="ChooseFolder_Click" />
      <Button Content="Paste" Click="Paste_Click" />
      <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Visibility="Collapsed" />
      <Button x:Name="SendButton" Content="Send" Click="Send_Click" IsEnabled="False"
          Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" />
    </StackPanel>
  </Grid>
</Page>
