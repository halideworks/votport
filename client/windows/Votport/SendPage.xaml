<Page x:Class="Votport.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="SEND" Style="{StaticResource SectionLabel}" />
    <TextBox x:Name="LinkBox" Grid.Row="1" PlaceholderText="Request link" />
    <PasswordBox x:Name="PasswordBox" Grid.Row="2" PlaceholderText="Password, if the link has one" />
    <Border x:Name="DropZone" Grid.Row="3" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
        Background="{StaticResource VotPanelBrush}" BorderBrush="{StaticResource VotBorderBrush}"
        BorderThickness="1" CornerRadius="6" MinHeight="160">
      <Grid>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{StaticResource VotMutedBrush}" />
          <TextBlock Text="Drop files or folders here" Foreground="{StaticResource VotMutedBrush}" />
        </StackPanel>
        <ListView x:Name="Paths" Visibility="Collapsed" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" Style="{StaticResource Mono}" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
      <Button Content="Choose Files" Click="Choose_Click" />
      <Button Content="Choose Folder" Click="ChooseFolder_Click" />
      <Button Content="Paste" Click="Paste_Click" />
      <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Visibility="Collapsed" />
      <Button x:Name="SendButton" Content="Send" Click="Send_Click" IsEnabled="False"
          Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" />
    </StackPanel>
  </Grid>
</Page>
