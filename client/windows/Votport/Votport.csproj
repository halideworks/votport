<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows shell: WinUI 3 on the Windows App SDK, consuming the Rust
       core as a DLL with the UniFFI C# bindings. build-core.ps1 produces
       both into Generated/, which is not committed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- The SDK's own floor; the supported floor is Windows 10 22H2. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Votport</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The ship on the web's navy square, rendered by scripts/app-icon.py. -->
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged for development; -p:WindowsPackageType=MSIX packages. -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <DefineConstants Condition="'$(WindowsPackageType)' == 'None'">$(DefineConstants);VOTPORT_UNPACKAGED</DefineConstants>
    <AppxBundle>Never</AppxBundle>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4188" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Generated\votport_client_core.dll">
      <!-- Beside the executable, where DllImport looks. -->
      <Link>votport_client_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\*.png;Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\design\sounds\completion.wav" Link="Assets\completion.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The OFL fonts from client/design/fonts with their licence texts,
         beside the executable under Assets\Fonts, where the ms-appx font
         URIs resolve. -->
    <Content Include="..\..\design\fonts\*" Link="Assets\Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
