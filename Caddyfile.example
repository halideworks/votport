# Example Caddy site for votport.
#
# Use this as the main Caddyfile, or merge it into yours: the options block
# below must be the first block of the main Caddyfile (Caddy refuses it
# anywhere else, including in an imported file), and the site block can go
# anywhere. Adjust the hostname and port to match the selected Compose file.
# Caddy terminates TLS; votport speaks plain HTTP on localhost.

# Audit finding 280: bounded timeouts. These are server-wide global options,
# so they belong in the main Caddyfile's global block, not an imported site
# file. Each is an absolute per-request bound, not reset as data flows: upload
# chunks are at most ~9 MiB per request, so an hour to read a body is
# generous, and no write timeout is set because a single-GET download of a
# large file can stream for hours.
{
	servers {
		timeouts {
			read_header 30s
			read_body 1h
			idle 5m
		}
	}
}

drop.example.com {
	# Compresses JS, CSS, and the multi-MB vot-wasm binary (3-4x smaller);
	# votport itself sends uncompressed responses and relies on the proxy.
	encode zstd gzip

	# The proxy serves TLS, so HSTS belongs here too; votport sends the
	# same header when VOTPORT_PUBLIC_URL is https.
	header Strict-Transport-Security "max-age=31536000"

	# Audit finding 273: /metrics (tenant keys) and /readyz (lease state)
	# answer only on the private upstream. The proxy 404s both before
	# anything reaches votport, even with a bearer token.
	respond /metrics 404
	respond /readyz 404

	reverse_proxy 127.0.0.1:8103

	# votport uploads travel as chunks of at most ~9 MiB per request, so no
	# special body-size configuration is needed. If you use a global
	# `request_body max_size` smaller than 10MB, override it here:
	# request_body {
	# 	max_size 10MB
	# }
}
