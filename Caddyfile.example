# Example Caddy site for votport.
#
# Add this to your existing Caddyfile (adjust the hostname and port to match
# docker-compose.yml). Caddy terminates TLS; votport speaks plain HTTP on
# localhost.

drop.example.com {
	# Compresses JS, CSS, and the multi-MB vot-wasm binary (3-4x smaller);
	# votport itself sends uncompressed responses and relies on the proxy.
	encode zstd gzip

	reverse_proxy 127.0.0.1:8321 {
		# /readyz turns 503 while the System page's Drain for restart is on,
		# so a second upstream (see docs/deployment.md, High availability)
		# takes over only when the live instance asks it to.
		health_uri /readyz
		health_interval 5s
	}

	# votport uploads travel as chunks of at most ~9 MiB per request, so no
	# special body-size configuration is needed. If you use a global
	# `request_body max_size` smaller than 10MB, override it here:
	# request_body {
	# 	max_size 10MB
	# }
}
